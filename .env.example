DATABASE_URL=postgresql://jansahay:jansahay@localhost:5432/jansahay
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_FULL_NAME=JanSahay Admin
ADMIN_EMAIL=admin@jansahay.dev
ADMIN_PASSWORD=change-admin-password

# Optional: required for AI assistant, embeddings, and speech-to-text
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Qdrant (vector store for semantic/document search)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=jansahay_documents
EMBEDDING_MODEL=gemini-embedding-001

# Neo4j (graph database for structured entity retrieval + GraphRAG)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=jansahay_neo4j
NEO4J_DATABASE=neo4j

# Voice settings
# STT provider: gemini (uses GEMINI_API_KEY above)
STT_PROVIDER=gemini
# TTS provider: gtts (no API key required)
TTS_PROVIDER=gtts
MAX_AUDIO_SIZE_MB=10
