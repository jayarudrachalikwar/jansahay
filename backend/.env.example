# ============================================
# JANSAHAY — ENVIRONMENT VARIABLE REFERENCE
# ============================================
# This file is safe to commit — it contains placeholders only.
# Copy it to backend/.env and fill in real values.
# Also enter these into Vercel → Settings → Environment Variables.
# ============================================

# Supabase PostgreSQL connection string
DATABASE_URL=YOUR_SUPABASE_DATABASE_URL

# JWT Authentication
JWT_SECRET_KEY=YOUR_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin user created on first migration/seed
ADMIN_FULL_NAME=JanSahay Admin
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# Google Gemini (used for AI assistant, embeddings, and STT)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash

# Qdrant Cloud (vector store)
QDRANT_URL=YOUR_QDRANT_CLOUD_URL
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION_NAME=jansahay_documents

# Embedding model (must match GEMINI_API_KEY account)
EMBEDDING_MODEL=gemini-embedding-001

# Neo4j AuraDB (graph database)
NEO4J_URI=YOUR_NEO4J_AURA_URI
NEO4J_USERNAME=YOUR_NEO4J_USERNAME
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
NEO4J_DATABASE=YOUR_NEO4J_DATABASE_NAME

# Document upload (optional — change only if needed)
DOCUMENT_UPLOAD_DIR=data/documents
MAX_UPLOAD_SIZE_MB=20

# Voice settings
STT_PROVIDER=gemini
TTS_PROVIDER=gtts
MAX_AUDIO_SIZE_MB=10
VOICE_TEMP_DIR=data/voice_tmp

# CORS — comma-separated list of allowed frontend origins
# Example: https://jansahay-frontend.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=YOUR_FRONTEND_VERCEL_URL
